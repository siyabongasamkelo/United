{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"],

    // 🎯 Realigned shortcut directly mapping to your unified shared folder layout
    "paths": {
      "@/shared/middleware/*": ["./shared/middleware/*"],
      "@/features/*": ["./features/*"]
    }
  },
  "include": ["features/**/*", "shared/middleware/**/*", "server.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
